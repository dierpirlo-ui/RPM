<Window x:Class="LabWork26.Window5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork26"
        mc:Ignorable="d"
        Title="Window5" Height="450" Width="800">
    <DockPanel>
        <WrapPanel Background="DeepSkyBlue" DockPanel.Dock="Top">
            <Button Content="Задание 1"/>
            <Button Content="Задание 2"/>
            <Button Content="Задание 3"/>
            <Button Content="Задание 4"/>
            <Button Content="Задание 5"/>
        </WrapPanel>
        <Label Content="Подвал" Background="ForestGreen" DockPanel.Dock="Bottom"/>
        <Label Content="Меню" Background="Bisque" DockPanel.Dock="Left"/>
        <Canvas Background="Goldenrod">
            <Image Source="/bird1.jpg" Height="150" Canvas.Left="10" Canvas.Top="10"/>
            <Image Source="/bird2.jpg" Height="150" Canvas.Left="10" Canvas.Bottom="10"/>
            <Image Source="/bird3.jpg" Height="150" Canvas.Right="10" Canvas.Top="10"/>
            <Image Source="/bird4.jpg" Height="150" Canvas.Right="10" Canvas.Bottom="10"/>
        </Canvas>
    </DockPanel>
</Window>
