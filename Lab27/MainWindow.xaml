<Window x:Class="LabWork27.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LabWork27"
        mc:Ignorable="d"
        Title="{Binding ElementName=ContentFrame, Path=Content.Title}" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Frame x:Name="ContentFrame" Grid.Row="1" ContentRendered="ContentFrame_ContentRendered" NavigationUIVisibility="Hidden"/>

        <Border Grid.Row="0" Background="ForestGreen">
            <DockPanel>
                <Image Source="/bird1.jpg"  DockPanel.Dock="Left"/>
                <Button x:Name="BackButton" Content="Назад" Width="100" FontSize="20" DockPanel.Dock="Right" Click="BackButton_Click"/>
                <Label x:Name="TitleLabel" Content="{Binding ElementName=ContentFrame, Path=Content.Title}" 
                    VerticalAlignment="Center" FontSize="20"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="2" Background="HotPink"/>
    </Grid>
</Window>
