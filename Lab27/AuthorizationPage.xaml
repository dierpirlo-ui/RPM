<Page x:Class="LabWork27.Pages.AuthorizationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LabWork27.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Авторизация">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center"> 
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Логин:" Grid.Column="0" Grid.Row="0"/>
        <TextBox Grid.Column="1" Grid.Row="0"/>

        <Label Content="Пароль:" Grid.Column="0" Grid.Row="1"/>
        <PasswordBox Grid.Column="1" Grid.Row="1"/>

        <StackPanel Grid.Column="1" Grid.Row="2" Width="100">
            <Button x:Name="LoginButton"  Content="Войти" Click="LoginButton_Click"/>
            <Button x:Name="RegistrationButton"  Content="Регистрация" Click="RegistrationButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
