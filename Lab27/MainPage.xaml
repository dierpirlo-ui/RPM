<Page x:Class="LabWork27.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LabWork27.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Главная">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="AuthorizationButton" Content="Авторизация" Width="200" Click="AuthorizationButton_Click"/>
        <Button x:Name="RegistrationButton" Content="Регистрация" Width="200" Click="RegistrationButton_Click"/>
        <Button x:Name="SettingsButton" Content="Настройки" Width="200" Click="SettingsButton_Click"/>
    </StackPanel>
</Page>
